# ---------------------------------------------------------------------------
# Cubitora environment
#
# Every variable here is OPTIONAL. With an empty .env the app still runs: all
# ten planners, the shopping list, saved projects, and the Project Pack preview
# and PDF all work. The variables below switch on the paid and third-party
# pieces one at a time.
#
# Copy to `.env.local` and fill in what you have.
# ---------------------------------------------------------------------------


# --- Site -------------------------------------------------------------------

# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph tags,
# the sitemap, and Stripe redirect URLs.
#
# Leave it empty on Vercel: the app falls back to Vercel's own production
# domain, which is supplied automatically. Set it once you attach a real domain.
NEXT_PUBLIC_SITE_URL=

# Shown on the contact page and in the legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=hello@cubitora.com


# --- Natural-language router ------------------------------------------------

# Optional. Without a key the deterministic parser handles the "What are you
# trying to build?" box on its own — it covers the common phrasings, and every
# planner remains fully usable by hand.
#
# The model only proposes a project and extracts numbers you already typed. It
# never performs a calculation.
ANTHROPIC_API_KEY=

# Any current Claude model. Haiku is the cost-appropriate default for this task.
ANTHROPIC_MODEL=claude-haiku-4-5

# Purely cosmetic: lets the UI mention AI assistance. Server behaviour depends
# on ANTHROPIC_API_KEY being present, not on this flag.
NEXT_PUBLIC_AI_ENABLED=false


# --- Project Pack + Stripe --------------------------------------------------

# Price in whole cents. 699 = $6.99.
NEXT_PUBLIC_PROJECT_PACK_PRICE_CENTS=699
NEXT_PUBLIC_PROJECT_PACK_CURRENCY=usd

# Set to "true" to unlock the Project Pack without any payment, for local work
# and demos. Off unless explicitly set to "true" — a forgotten flag should cost
# a demo, not the revenue. The server refuses it on production deployments in
# any case, so this is convenience rather than a security control.
NEXT_PUBLIC_PROJECT_PACK_DEV_UNLOCK=true

# Set to "true" to give the Project Pack away, as a stated product decision —
# this is how you run a free beta. Deliberately NOT the same flag as the dev
# unlock above: this one is honoured in production, that one never is. Keeping
# them separate means "free during beta" is never expressed by leaving a
# development flag switched on, which is how the paid product got given away by
# accident once already.
#
# With neither this nor a Stripe key set, the pack is unavailable rather than
# free, and the unlock panel says so plainly.
NEXT_PUBLIC_PROJECT_PACK_FREE=

# Stripe test-mode secret key (sk_test_...). Live keys are refused unless
# STRIPE_ALLOW_LIVE_MODE is explicitly "true", so a stray production key cannot
# start charging people by accident.
STRIPE_SECRET_KEY=
STRIPE_ALLOW_LIVE_MODE=false

# Signing secret from `stripe listen` or the Stripe dashboard. Optional — the
# unlock is granted by verifying the checkout session, not by the webhook.
STRIPE_WEBHOOK_SECRET=


# --- Analytics --------------------------------------------------------------

# Vercel Web Analytics needs NO configuration. Page views, visitors, routes,
# referrers, countries, devices, browsers, and operating systems are collected
# automatically on every Vercel deployment, and Vercel separates production,
# preview, and local traffic itself.

# Vercel custom events (the product funnel: project_started, project_completed,
# project_saved, project_pack_previewed, …) require Web Analytics Plus, a paid
# tier. Leave this off unless that is enabled — sending events without it is a
# silent no-op, so we would be pretending to collect data.
NEXT_PUBLIC_VERCEL_CUSTOM_EVENTS=false

# Google Analytics measurement ID (G-XXXXXXXXXX). Optional and independent of
# Vercel. With no ID, no GA script is loaded at all.
NEXT_PUBLIC_ANALYTICS_ID=

# Logs product events to the browser console instead of sending them. Handy
# locally for checking what an interaction would report.
NEXT_PUBLIC_ANALYTICS_DEBUG=false


# --- Advertising ------------------------------------------------------------

# Ad slots render nothing unless this is "true". They never appear inside a
# calculator, and they reserve fixed height so they cannot cause layout shift.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_AD_CLIENT_ID=


# --- Affiliate links --------------------------------------------------------

# "Shop materials" destination. {query} is replaced with the search term.
# Defaults to a plain web search so nothing implies a retailer relationship
# that does not exist.
NEXT_PUBLIC_AFFILIATE_ENABLED=true
NEXT_PUBLIC_AFFILIATE_SEARCH_URL=https://www.google.com/search?q={query}

# Shown as a disclosure under affiliate links, e.g. "As an Example Associate…".
# Leave empty until you have a real affiliate relationship to disclose.
NEXT_PUBLIC_AFFILIATE_PARTNER_LABEL=


# --- Future scope -----------------------------------------------------------

# Contractor lead capture is architected for but not built. Leave off.
NEXT_PUBLIC_CONTRACTOR_LEADS_ENABLED=false


# --- Beta ------------------------------------------------------------------

# The "Beta" chip beside the logo and the beta section on /about. This is the
# one flag here that defaults ON: the risk runs the other way, since telling
# people the estimates are still being validated costs nothing while staying
# quiet about it during a beta is what misleads. Set to "false" to remove it.
NEXT_PUBLIC_BETA=

# Where "Does this estimate look wrong?" points. A hosted form if you have one;
# otherwise it falls back to a mailto with the planner, unit system, build id,
# and route prefilled — never dimensions, notes, or free text.
NEXT_PUBLIC_FEEDBACK_URL=
NEXT_PUBLIC_FEEDBACK_EMAIL=

# Overrides the build identifier shown in the footer. Vercel supplies the commit
# SHA automatically, so this is only needed outside Vercel.
NEXT_PUBLIC_BUILD_ID=
